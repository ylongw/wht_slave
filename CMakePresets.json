{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "true"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_PROJECT_NAME": "wht_slave",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_PROJECT_NAME": "wht_slave",
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-EXAM-INSTRUMENTS",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_PROJECT_NAME": "wht_slave",
                "CMAKE_BUILD_TYPE": "Debug",
                "WHT_APP_RUN_MODE": "6"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-EXAM-INSTRUMENTS",
            "configurePreset": "Debug-EXAM-INSTRUMENTS"
        }
    ]
}